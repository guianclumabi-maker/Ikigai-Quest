[
 {
  "id": "a8369874c",
  "text": "あめ"
 },
 {
  "id": "af4bf3faf",
  "text": "おばさん"
 },
 {
  "id": "ab6cb34c7",
  "text": "おばあさん"
 },
 {
  "id": "a6a22c145",
  "text": "きって"
 },
 {
  "id": "ada49cfb5",
  "text": "がっこう"
 },
 {
  "id": "ae615a488",
  "text": "しんぶん"
 },
 {
  "id": "a5a7b5451",
  "text": "きょう"
 },
 {
  "id": "a1fb8a05f",
  "text": "えいが"
 },
 {
  "id": "adc7e37b6",
  "text": "りょうり"
 },
 {
  "id": "ab6cff526",
  "text": "はじめまして。"
 },
 {
  "id": "a83f1eae0",
  "text": "よろしくお願いします。"
 },
 {
  "id": "a8314b6e3",
  "text": "すみません。"
 },
 {
  "id": "a4ffb347a",
  "text": "ありがとうございます。"
 },
 {
  "id": "a4b1b4d64",
  "text": "これをください。"
 },
 {
  "id": "acac7327d",
  "text": "水をください。"
 },
 {
  "id": "af93a73b5",
  "text": "もう一度お願いします。"
 },
 {
  "id": "ac2a15ff1",
  "text": "ゆっくり話してください。"
 },
 {
  "id": "ae40e68e9",
  "text": "わかりません。"
 },
 {
  "id": "ad02bd175",
  "text": "トイレはどこですか。"
 },
 {
  "id": "a052cf47d",
  "text": "いち、に、さん"
 },
 {
  "id": "a3fb9a0d0",
  "text": "よん、ご、ろく"
 },
 {
  "id": "ae147c1eb",
  "text": "なな、はち、きゅう、じゅう"
 },
 {
  "id": "adbbbdc1d",
  "text": "にじゅう"
 },
 {
  "id": "aabbad6e8",
  "text": "さんじゅうご"
 },
 {
  "id": "a4048be97",
  "text": "ひゃく"
 },
 {
  "id": "a1aa6141e",
  "text": "いちがつ"
 },
 {
  "id": "a6646d6cd",
  "text": "ろくがつ"
 },
 {
  "id": "a13b3a77c",
  "text": "にちようび"
 },
 {
  "id": "a082fdc7c",
  "text": "きんようび"
 },
 {
  "id": "a6ade9459",
  "text": "私はアナです。"
 },
 {
  "id": "abd2fc0bd",
  "text": "フィリピンから来ました。"
 },
 {
  "id": "a6a14b2bc",
  "text": "マニラに住んでいます。"
 },
 {
  "id": "af392dfda",
  "text": "会社員です。"
 },
 {
  "id": "ab8f8d7a0",
  "text": "学生です。"
 },
 {
  "id": "a436707cc",
  "text": "日本語を勉強しています。"
 },
 {
  "id": "a661de8ea",
  "text": "趣味は音楽です。"
 },
 {
  "id": "a36fb8496",
  "text": "こちらこそ、よろしくお願いします。"
 },
 {
  "id": "a749e1f84",
  "text": "私は学生です。"
 },
 {
  "id": "a8e0bbf88",
  "text": "田中さんは先生です。"
 },
 {
  "id": "ac5248528",
  "text": "これは日本語の本です。"
 },
 {
  "id": "a96249f01",
  "text": "今日は休みです。"
 },
 {
  "id": "a8dd2654a",
  "text": "母は会社員です。"
 },
 {
  "id": "afc2bf78d",
  "text": "あの人は友達です。"
 },
 {
  "id": "ad73389d2",
  "text": "私は医者じゃありません。"
 },
 {
  "id": "a3e838deb",
  "text": "山田さんは日本人ですか。"
 },
 {
  "id": "a90493c00",
  "text": "はい、そうです。"
 },
 {
  "id": "a042ab131",
  "text": "いいえ、学生ではありません。"
 },
 {
  "id": "a13ddd519",
  "text": "これは水です。"
 },
 {
  "id": "a2962b2ac",
  "text": "それは私の傘です。"
 },
 {
  "id": "a31afeca3",
  "text": "あの店は駅の前です。"
 },
 {
  "id": "af616c3eb",
  "text": "この本はおもしろいです。"
 },
 {
  "id": "a4b3d8e73",
  "text": "その人は私の先生です。"
 },
 {
  "id": "a5309310f",
  "text": "机の上に本があります。"
 },
 {
  "id": "adcb9e3b7",
  "text": "部屋に猫がいます。"
 },
 {
  "id": "a813f52b8",
  "text": "冷蔵庫に牛乳があります。"
 },
 {
  "id": "a2fde8e8b",
  "text": "学校に友達がいます。"
 },
 {
  "id": "a47f39e34",
  "text": "あそこに駅があります。"
 },
 {
  "id": "a2b8a10c7",
  "text": "毎朝パンを食べます。"
 },
 {
  "id": "a9d2cc3e5",
  "text": "水を飲みます。"
 },
 {
  "id": "a4f61c784",
  "text": "新聞を読みます。"
 },
 {
  "id": "ab93b813f",
  "text": "今日はコーヒーを飲みません。"
 },
 {
  "id": "afcbb6efd",
  "text": "昨日、映画を見ました。"
 },
 {
  "id": "ae5ca5bc1",
  "text": "土曜日に買い物をしました。"
 },
 {
  "id": "a316c39f0",
  "text": "先週は働きませんでした。"
 },
 {
  "id": "a566d55c0",
  "text": "よく音楽を聞きます。"
 },
 {
  "id": "a12dfe11d",
  "text": "夜に宿題をします。"
 },
 {
  "id": "a7f876968",
  "text": "日曜日に友達に会いました。"
 },
 {
  "id": "ad0902946",
  "text": "七時に起きます。"
 },
 {
  "id": "a8e820ee4",
  "text": "月曜日に日本へ行きます。"
 },
 {
  "id": "a8f62959f",
  "text": "学校で勉強します。"
 },
 {
  "id": "adb99cd90",
  "text": "家で昼ご飯を食べます。"
 },
 {
  "id": "ae52cb9a1",
  "text": "電車で会社へ行きます。"
 },
 {
  "id": "a47d3f249",
  "text": "箸で魚を食べます。"
 },
 {
  "id": "a55d7bf76",
  "text": "友達に会います。"
 },
 {
  "id": "a6c6b95fe",
  "text": "駅まで歩きます。"
 },
 {
  "id": "ae31cb6e3",
  "text": "店で水を買います。"
 },
 {
  "id": "a89fb460e",
  "text": "八時に家を出ます。"
 },
 {
  "id": "a86a4e4b3",
  "text": "この店は安いです。"
 },
 {
  "id": "a449d0406",
  "text": "この本はおもしろくないです。"
 },
 {
  "id": "a316be7c9",
  "text": "昨日は暑かったです。"
 },
 {
  "id": "a66c9ecc5",
  "text": "静かな町です。"
 },
 {
  "id": "ab73fc300",
  "text": "町は静かです。"
 },
 {
  "id": "a8633dd60",
  "text": "この町は便利じゃありません。"
 },
 {
  "id": "ae025730e",
  "text": "私は猫が好きです。"
 },
 {
  "id": "a74557307",
  "text": "弟は野菜がきらいです。"
 },
 {
  "id": "a6c49de25",
  "text": "電車よりバスのほうが安いです。"
 },
 {
  "id": "ac70d561e",
  "text": "このかばんはあのかばんより軽いです。"
 },
 {
  "id": "a0fc5ca10",
  "text": "かく、かいて、かかない"
 },
 {
  "id": "ac15a999f",
  "text": "のむ、のんで、のまない"
 },
 {
  "id": "aae15c001",
  "text": "はなす、はなして、はなさない"
 },
 {
  "id": "a03402831",
  "text": "まつ、まって、またない"
 },
 {
  "id": "a34c3064c",
  "text": "かう、かって、かわない"
 },
 {
  "id": "a443217e6",
  "text": "たべる、たべて、たべない"
 },
 {
  "id": "a4ced9d3d",
  "text": "みる、みて、みない"
 },
 {
  "id": "ac4fb6bb7",
  "text": "する、して、しない"
 },
 {
  "id": "accba338f",
  "text": "くる、きて、こない"
 },
 {
  "id": "acc29c5cd",
  "text": "かえる、かえって、かえらない"
 },
 {
  "id": "a5271a8bd",
  "text": "朝ご飯を食べて、学校へ行きます。"
 },
 {
  "id": "a68ad7811",
  "text": "名前を書いてください。"
 },
 {
  "id": "adda57320",
  "text": "ここに座ってもいいです。"
 },
 {
  "id": "adbca1fe7",
  "text": "ここで写真を撮ってはいけません。"
 },
 {
  "id": "af57839b6",
  "text": "今、本を読んでいます。"
 },
 {
  "id": "a58702d31",
  "text": "東京に住んでいます。"
 },
 {
  "id": "a6382ce4a",
  "text": "窓を開けてください。"
 },
 {
  "id": "a57307b5c",
  "text": "このペンを使ってもいいですか。"
 },
 {
  "id": "a62784f99",
  "text": "図書館で食べてはいけません。"
 },
 {
  "id": "a60c99a0b",
  "text": "友達を待っています。"
 },
 {
  "id": "a3cd4b88e",
  "text": "日本へ行きたいです。"
 },
 {
  "id": "a74acc0c3",
  "text": "水を飲みたいです。"
 },
 {
  "id": "ad8ac4c7d",
  "text": "週末に映画を見ませんか。"
 },
 {
  "id": "a6abf305e",
  "text": "いっしょに昼ご飯を食べましょう。"
 },
 {
  "id": "a179fd31b",
  "text": "六時に駅で会いましょう。"
 },
 {
  "id": "a64ac5b22",
  "text": "九時から五時まで働きます。"
 },
 {
  "id": "a3aef0edc",
  "text": "日曜日から旅行します。"
 },
 {
  "id": "ae49d2961",
  "text": "今夜、レストランで食べませんか。"
 },
 {
  "id": "aac1abcc3",
  "text": "少し休みましょう。"
 },
 {
  "id": "ae737a44d",
  "text": "何をしたいですか。"
 },
 {
  "id": "a9c49be1c",
  "text": "雨ですから、家にいます。"
 },
 {
  "id": "a8d8a86a3",
  "text": "時間がありませんから、タクシーで行きます。"
 },
 {
  "id": "a1498ecd2",
  "text": "朝ご飯を食べます。そして、学校へ行きます。"
 },
 {
  "id": "a18528497",
  "text": "店へ行きました。それから、家へ帰りました。"
 },
 {
  "id": "a38a6eb35",
  "text": "この店は小さいです。でも、安いです。"
 },
 {
  "id": "a1fc964d2",
  "text": "日本語は難しいですが、おもしろいです。"
 },
 {
  "id": "a71b1941a",
  "text": "友達が来ますから、掃除します。"
 },
 {
  "id": "a856e03d7",
  "text": "日曜日ですから、銀行は休みです。"
 },
 {
  "id": "a4ac6e3a7",
  "text": "駅まで歩きます。そして、電車に乗ります。"
 },
 {
  "id": "a2f28a333",
  "text": "忙しいですが、毎日勉強します。"
 },
 {
  "id": "accd00946",
  "text": "受付は九時からです。"
 },
 {
  "id": "a62688f80",
  "text": "土曜日は休みです。"
 },
 {
  "id": "a0ea3bfd3",
  "text": "申込みは金曜日までです。"
 },
 {
  "id": "ab9c5ac06",
  "text": "ここで名前を書いてください。"
 },
 {
  "id": "aaf743708",
  "text": "飲み物は自分で持って来てください。"
 },
 {
  "id": "a42e6e38c",
  "text": "二階の教室で試験をします。"
 },
 {
  "id": "a40fba40a",
  "text": "午後は三時に終わります。"
 },
 {
  "id": "a2efef266",
  "text": "学生は学生証を見せてください。"
 },
 {
  "id": "a119b2c26",
  "text": "雨の時は体育館でします。"
 },
 {
  "id": "a75f7fac1",
  "text": "電話で予約してください。"
 },
 {
  "id": "a3d01bb20",
  "text": "書く、書かない、書いた"
 },
 {
  "id": "a5205abd4",
  "text": "飲む、飲まない、飲んだ"
 },
 {
  "id": "a5b80d100",
  "text": "はなす、はなさない、はなした"
 },
 {
  "id": "a8e161dd5",
  "text": "待つ、待たない、待った"
 },
 {
  "id": "aef96261f",
  "text": "食べる、食べない、食べた"
 },
 {
  "id": "a76aac582",
  "text": "見る、見ない、見た"
 },
 {
  "id": "afadd7200",
  "text": "する、しない、した"
 },
 {
  "id": "a0db22ae0",
  "text": "来る、来ない、来た"
 },
 {
  "id": "a3e9565dd",
  "text": "高い、高くない、高かった"
 },
 {
  "id": "acd07a8fd",
  "text": "静かだ、静かではない、静かだった"
 },
 {
  "id": "a56dd904f",
  "text": "明日は雨が降ると思います。"
 },
 {
  "id": "a01afcb32",
  "text": "昨日、映画を見た。"
 },
 {
  "id": "a210ae59e",
  "text": "この店は安くないと思います。"
 },
 {
  "id": "a8ecb31b0",
  "text": "友達が来ると言いました。"
 },
 {
  "id": "a1b37c6cc",
  "text": "駅へ行く人はあのバスに乗ります。"
 },
 {
  "id": "aeeeb92e6",
  "text": "日本で買ったかばんです。"
 },
 {
  "id": "aac8de466",
  "text": "明日は早く起きなければなりません。"
 },
 {
  "id": "a1ae3d746",
  "text": "時間があったら、電話します。"
 },
 {
  "id": "af55f6d3c",
  "text": "週末は出かけないつもりです。"
 },
 {
  "id": "a4d1605c3",
  "text": "何を食べるか決めました。"
 },
 {
  "id": "a72ce2bb7",
  "text": "電車が遅れたので、遅刻しました。"
 },
 {
  "id": "ae6912341",
  "text": "忙しいから、今日は行けません。"
 },
 {
  "id": "a3d893fa5",
  "text": "安いけど、少し遠いです。"
 },
 {
  "id": "a4bf540fc",
  "text": "この町は静かだし、便利だし、住みやすいです。"
 },
 {
  "id": "a07051ee5",
  "text": "先週買った本を読みました。"
 },
 {
  "id": "a6d9b44d1",
  "text": "母が作ったケーキはおいしかったです。"
 },
 {
  "id": "a7b0c97d5",
  "text": "日本で働いている友達がいます。"
 },
 {
  "id": "a6def1ab8",
  "text": "雨が降っているけれど、出かけます。"
 },
 {
  "id": "a7d591f73",
  "text": "駅に近いので、この家にしました。"
 },
 {
  "id": "afb2adaa8",
  "text": "料理が好きだし、毎日作ります。"
 },
 {
  "id": "af6091dbf",
  "text": "寝る前に、歯を磨きます。"
 },
 {
  "id": "a3ce276e0",
  "text": "仕事が終わった後で、買い物をします。"
 },
 {
  "id": "a31070179",
  "text": "音楽を聞きながら、料理します。"
 },
 {
  "id": "a82ee3d82",
  "text": "歩きながら電話をしないでください。"
 },
 {
  "id": "ae1706c1d",
  "text": "休みの日は本を読んだり、映画を見たりします。"
 },
 {
  "id": "a4bb8e6c9",
  "text": "日曜日は掃除したり、洗濯したりしました。"
 },
 {
  "id": "af0bae6be",
  "text": "駅に着いてから、友達に電話します。"
 },
 {
  "id": "ac33d7c3c",
  "text": "出かける前に、窓を閉めました。"
 },
 {
  "id": "a249ca86f",
  "text": "宿題を忘れてしまいました。"
 },
 {
  "id": "abf7f7fb7",
  "text": "昼ご飯を食べてから、会議に出ます。"
 },
 {
  "id": "a62269010",
  "text": "日本語を少し話すことができます。"
 },
 {
  "id": "a760cfaf0",
  "text": "この図書館で本を借りることができます。"
 },
 {
  "id": "a0fbffc25",
  "text": "毎日練習して、泳げるようになりました。"
 },
 {
  "id": "a7d30604f",
  "text": "最近、早く起きるようになりました。"
 },
 {
  "id": "af9476833",
  "text": "来月から毎朝走ることにしました。"
 },
 {
  "id": "a3bc19a96",
  "text": "会議はオンラインですることになりました。"
 },
 {
  "id": "a15119d77",
  "text": "今年は日本語を勉強するつもりです。"
 },
 {
  "id": "aed3f4f2e",
  "text": "週末は家で休むつもりです。"
 },
 {
  "id": "ae2308a5e",
  "text": "このアプリで漢字の読み方を調べられます。"
 },
 {
  "id": "ad4bb775b",
  "text": "薬を飲んで、よく眠れるようになりました。"
 },
 {
  "id": "a99d2bb4b",
  "text": "妹に日本語を教えてあげました。"
 },
 {
  "id": "a785a75b5",
  "text": "友達が駅まで送ってくれました。"
 },
 {
  "id": "a0d014c3c",
  "text": "先生に作文を見てもらいました。"
 },
 {
  "id": "a36ea7d2a",
  "text": "母が弁当を作ってくれました。"
 },
 {
  "id": "a2d939557",
  "text": "弟の宿題を手伝ってあげます。"
 },
 {
  "id": "a5321b3bb",
  "text": "友達に写真を撮ってもらいました。"
 },
 {
  "id": "a192a65b7",
  "text": "もう一度説明していただけませんか。"
 },
 {
  "id": "ae2aaf1ef",
  "text": "この書類を確認していただけませんか。"
 },
 {
  "id": "afa4ae017",
  "text": "駅まで案内してくれて、ありがとう。"
 },
 {
  "id": "a52d9648c",
  "text": "荷物を持ってもらえますか。"
 },
 {
  "id": "a9e020b3a",
  "text": "このボタンを押すと、ドアが開きます。"
 },
 {
  "id": "a311d97fb",
  "text": "駅に着いたら、電話してください。"
 },
 {
  "id": "a17f0ef0c",
  "text": "日本へ行くなら、春がいいです。"
 },
 {
  "id": "a31349dc2",
  "text": "雨が降っても、試合をします。"
 },
 {
  "id": "a5d746f47",
  "text": "時間があったら、手伝ってください。"
 },
 {
  "id": "af826c549",
  "text": "この道をまっすぐ行くと、駅があります。"
 },
 {
  "id": "a77337661",
  "text": "わからなかったら、先生に聞いてください。"
 },
 {
  "id": "a29889d33",
  "text": "車なら、二時間ぐらいです。"
 },
 {
  "id": "afd468cde",
  "text": "高くても、このかばんを買いたいです。"
 },
 {
  "id": "aff78c15e",
  "text": "春になると、花が咲きます。"
 },
 {
  "id": "a3981070f",
  "text": "今年は去年より忙しいです。"
 },
 {
  "id": "af6881016",
  "text": "電車はバスほど便利ではありません。"
 },
 {
  "id": "a2bb1ca9d",
  "text": "だんだん暖かくなりました。"
 },
 {
  "id": "a99eb884b",
  "text": "子どもが大きくなりました。"
 },
 {
  "id": "a4ed15b9b",
  "text": "部屋が静かになりました。"
 },
 {
  "id": "a3374c846",
  "text": "この問題は難しすぎます。"
 },
 {
  "id": "a71d45eea",
  "text": "昨日は食べすぎました。"
 },
 {
  "id": "a871e8957",
  "text": "駅の近くに新しい店ができました。"
 },
 {
  "id": "a9f7fb0c8",
  "text": "私は兄ほど背が高くありません。"
 },
 {
  "id": "a920361ec",
  "text": "日本語が少し上手になりました。"
 },
 {
  "id": "a22da6c06",
  "text": "早く寝たほうがいいです。"
 },
 {
  "id": "aeb043ac0",
  "text": "夜にコーヒーを飲まないほうがいいです。"
 },
 {
  "id": "ac3f068b9",
  "text": "明日までに宿題を出さなければなりません。"
 },
 {
  "id": "ac9e3a732",
  "text": "病院へ行かなくてはいけません。"
 },
 {
  "id": "af5640d9b",
  "text": "今日は来なくてもいいです。"
 },
 {
  "id": "a6a0dc1dc",
  "text": "全部食べなくてもいいです。"
 },
 {
  "id": "adbbe76a5",
  "text": "薬を飲んだほうがいいですよ。"
 },
 {
  "id": "a8367adbe",
  "text": "雨の日は運転しないほうがいいです。"
 },
 {
  "id": "a2d192a86",
  "text": "試験の前に、よく寝なければなりません。"
 },
 {
  "id": "ad9b37409",
  "text": "予約しなくても入れます。"
 },
 {
  "id": "af981f2d0",
  "text": "明日は晴れると思います。"
 },
 {
  "id": "a84fa4241",
  "text": "田中さんは来ないと言っていました。"
 },
 {
  "id": "a81deede7",
  "text": "このケーキはおいしそうです。"
 },
 {
  "id": "afd15bd71",
  "text": "雨が降りそうです。"
 },
 {
  "id": "a37a163dc",
  "text": "先生は試験は簡単だと言いました。"
 },
 {
  "id": "aeb4ca210",
  "text": "友達によると、店は休みだそうです。"
 },
 {
  "id": "abe195c00",
  "text": "この料理は辛そうです。"
 },
 {
  "id": "aec8ddd87",
  "text": "ニュースでは、電車が遅れるそうです。"
 },
 {
  "id": "a2118d58f",
  "text": "明日は寒くなると思います。"
 },
 {
  "id": "ad9ebfa3a",
  "text": "彼は後で電話すると言っていました。"
 },
 {
  "id": "abff54c41",
  "text": "駅はあそこです。"
 },
 {
  "id": "af2da4417",
  "text": "日本語は少し難しいです。"
 },
 {
  "id": "a5d0804b2",
  "text": "私はコーヒーを飲みます。"
 },
 {
  "id": "a0de00ec2",
  "text": "日曜日は家にいます。"
 },
 {
  "id": "afe87b995",
  "text": "この店は八時に開きます。"
 },
 {
  "id": "a21c07b3d",
  "text": "友達が三人来ます。"
 },
 {
  "id": "a647f6389",
  "text": "私は音楽が好きです。"
 },
 {
  "id": "adab0545a",
  "text": "日本語が分かります。"
 },
 {
  "id": "adb98fcac",
  "text": "雨が降っています。"
 },
 {
  "id": "a9f3549ca",
  "text": "どれがあなたのかばんですか。"
 },
 {
  "id": "a9a12bc14",
  "text": "時間がありません。"
 },
 {
  "id": "a9f7f180d",
  "text": "映画を見ました。"
 },
 {
  "id": "aae738ead",
  "text": "音楽を聞きます。"
 },
 {
  "id": "a5426962a",
  "text": "宿題をします。"
 },
 {
  "id": "a4d7e31ef",
  "text": "手紙を書きます。"
 },
 {
  "id": "a3d9efb42",
  "text": "コーヒーをください。"
 },
 {
  "id": "ad75cf2ac",
  "text": "四時に会います。"
 },
 {
  "id": "ac79e36b8",
  "text": "駅に着きました。"
 },
 {
  "id": "ad962f464",
  "text": "先生に質問します。"
 },
 {
  "id": "ade07b0ca",
  "text": "図書館で本を読みます。"
 },
 {
  "id": "a5c149d70",
  "text": "日本語で話します。"
 },
 {
  "id": "a7c43f1dc",
  "text": "公園で友達と会います。"
 },
 {
  "id": "ac85e459e",
  "text": "バスで学校へ行きます。"
 },
 {
  "id": "a483ce594",
  "text": "日本へ行きます。"
 },
 {
  "id": "a05690090",
  "text": "学校へ行きます。"
 },
 {
  "id": "a225a3ff7",
  "text": "駅へ歩きます。"
 },
 {
  "id": "afa887b6e",
  "text": "友達の家へ行きます。"
 },
 {
  "id": "ab8abeff3",
  "text": "来週、大阪へ行きます。"
 },
 {
  "id": "a998639c5",
  "text": "昼ご飯の後、会社へ戻ります。"
 },
 {
  "id": "a6bd8d787",
  "text": "母は病院へ行きました。"
 },
 {
  "id": "a46532eeb",
  "text": "このバスは空港へ行きます。"
 },
 {
  "id": "a00d9bfdb",
  "text": "日本へ留学したいです。"
 },
 {
  "id": "acc18822d",
  "text": "まっすぐ行くと、銀行へ着きます。"
 },
 {
  "id": "a840b0a43",
  "text": "友達と話します。"
 },
 {
  "id": "a36ea0e4d",
  "text": "母と買い物に行きます。"
 },
 {
  "id": "a6c96baa1",
  "text": "友達と映画を見ます。"
 },
 {
  "id": "a347919ae",
  "text": "姉と東京へ行きました。"
 },
 {
  "id": "a2e1cdeed",
  "text": "先生と日本語を練習します。"
 },
 {
  "id": "ae18aa2cb",
  "text": "パンと牛乳を買います。"
 },
 {
  "id": "aa81510db",
  "text": "犬と猫がいます。"
 },
 {
  "id": "a2334f02b",
  "text": "りんごとみかんを食べました。"
 },
 {
  "id": "ae311738f",
  "text": "山田さんと申します。"
 },
 {
  "id": "a4aea8452",
  "text": "だれと昼ご飯を食べますか。"
 },
 {
  "id": "a6a192f29",
  "text": "私も学生です。"
 },
 {
  "id": "a6d606078",
  "text": "田中さんも来ます。"
 },
 {
  "id": "af0e8d961",
  "text": "これも私の本です。"
 },
 {
  "id": "a858ddcce",
  "text": "日曜日も働きます。"
 },
 {
  "id": "a64a5d9cc",
  "text": "コーヒーもお茶も好きです。"
 },
 {
  "id": "a57fd7689",
  "text": "友達も日本語を勉強しています。"
 },
 {
  "id": "a5904183f",
  "text": "昨日も雨でした。"
 },
 {
  "id": "a095e5ec5",
  "text": "この店にもパンがあります。"
 },
 {
  "id": "a060b110b",
  "text": "私は魚も肉も食べます。"
 },
 {
  "id": "aab1c93b9",
  "text": "何も食べませんでした。"
 },
 {
  "id": "ae93a974c",
  "text": "私の本です。"
 },
 {
  "id": "a444dffa6",
  "text": "友達のかばんです。"
 },
 {
  "id": "afc8439fd",
  "text": "日本語の先生です。"
 },
 {
  "id": "ae62e23a2",
  "text": "駅の前に店があります。"
 },
 {
  "id": "ae94978fa",
  "text": "母の車です。"
 },
 {
  "id": "a031456c8",
  "text": "学校の近くに公園があります。"
 },
 {
  "id": "a7bad993b",
  "text": "これは日本の食べ物です。"
 },
 {
  "id": "a42fbdbcf",
  "text": "山田さんの家は大きいです。"
 },
 {
  "id": "aac68967f",
  "text": "雨の日は家で本を読みます。"
 },
 {
  "id": "a6740ade1",
  "text": "九時から働きます。"
 },
 {
  "id": "aa63c6902",
  "text": "東京から大阪まで新幹線で行きます。"
 },
 {
  "id": "a64cd4e9a",
  "text": "月曜日から金曜日まで学校へ行きます。"
 },
 {
  "id": "ac3d47d15",
  "text": "友達から手紙をもらいました。"
 },
 {
  "id": "a3490a596",
  "text": "家から駅まで十分です。"
 },
 {
  "id": "ae6521a11",
  "text": "まず、ここから読んでください。"
 },
 {
  "id": "a0b7d737b",
  "text": "五時まで働きます。"
 },
 {
  "id": "a0be13e7b",
  "text": "学校までバスで行きます。"
 },
 {
  "id": "ae1a37b27",
  "text": "ここまで読んでください。"
 },
 {
  "id": "a97a10726",
  "text": "昼休みは十二時から一時までです。"
 },
 {
  "id": "a265fe73d",
  "text": "明日までに宿題を出します。"
 },
 {
  "id": "a7c9d423f",
  "text": "この道は公園まで続きます。"
 },
 {
  "id": "aa37eb12b",
  "text": "学生ですか。"
 },
 {
  "id": "a69b24c83",
  "text": "これはあなたの本ですか。"
 },
 {
  "id": "acd3c8300",
  "text": "明日は休みですか。"
 },
 {
  "id": "a83312da8",
  "text": "駅はどこですか。"
 },
 {
  "id": "a640083c6",
  "text": "だれが来ますか。"
 },
 {
  "id": "a37434739",
  "text": "何時に帰りますか。"
 },
 {
  "id": "adaeb5920",
  "text": "お茶か水をください。"
 },
 {
  "id": "a704a4509",
  "text": "電車かバスで行きます。"
 },
 {
  "id": "a99a3a6c8",
  "text": "どの本を読みますか。"
 },
 {
  "id": "aadfa9ee1",
  "text": "日本語を勉強しますか。"
 },
 {
  "id": "aacea15dd",
  "text": "水だけ飲みました。"
 },
 {
  "id": "a0351da8e",
  "text": "一つだけください。"
 },
 {
  "id": "ac3be0019",
  "text": "今日は一時間だけ勉強します。"
 },
 {
  "id": "a109a79be",
  "text": "日曜日だけ休みです。"
 },
 {
  "id": "a8df13058",
  "text": "この店だけ開いています。"
 },
 {
  "id": "ad4ed0782",
  "text": "千円だけ持っています。"
 },
 {
  "id": "a133351ea",
  "text": "名前だけ書いてください。"
 },
 {
  "id": "ae768a8c4",
  "text": "少しだけ待ってください。"
 },
 {
  "id": "ac31fbdce",
  "text": "私だけ知っています。"
 },
 {
  "id": "a6ab3a428",
  "text": "今週は二日だけ働きます。"
 },
 {
  "id": "a9fb083e7",
  "text": "水しかありません。"
 },
 {
  "id": "afe1d8676",
  "text": "千円しか持っていません。"
 },
 {
  "id": "ac83d49c7",
  "text": "一人しか来ませんでした。"
 },
 {
  "id": "aa4333861",
  "text": "日曜日しか休めません。"
 },
 {
  "id": "a502c6080",
  "text": "ひらがなしか読めません。"
 },
 {
  "id": "ad0183755",
  "text": "この店でしか買えません。"
 },
 {
  "id": "a4de1fe33",
  "text": "五分しかありません。"
 },
 {
  "id": "afbdf0ee6",
  "text": "一回しか見ていません。"
 },
 {
  "id": "a6a97d770",
  "text": "野菜しか食べませんでした。"
 },
 {
  "id": "af3d99f03",
  "text": "私しか知りません。"
 },
 {
  "id": "aa1cbc59d",
  "text": "机の上に本やノートがあります。"
 },
 {
  "id": "a74b91d82",
  "text": "スーパーで野菜や果物を買いました。"
 },
 {
  "id": "a6b145330",
  "text": "休みの日は映画や音楽を楽しみます。"
 },
 {
  "id": "a9bcbd0cd",
  "text": "京都や奈良へ行きたいです。"
 },
 {
  "id": "a2b2fd9ec",
  "text": "かばんに財布や鍵が入っています。"
 },
 {
  "id": "a5b273605",
  "text": "日本語や英語を勉強しています。"
 },
 {
  "id": "a477768aa",
  "text": "公園で走ったり、花や木を見たりします。"
 },
 {
  "id": "a18410835",
  "text": "朝はパンや卵を食べます。"
 },
 {
  "id": "a6c5e4156",
  "text": "駅の近くに銀行や郵便局があります。"
 },
 {
  "id": "a2af8c85c",
  "text": "旅行で写真やお土産を買いました。"
 },
 {
  "id": "a680f1845",
  "text": "今日は昨日より暖かいです。"
 },
 {
  "id": "ab3563b1e",
  "text": "日本語は英語より難しいです。"
 },
 {
  "id": "a722123dd",
  "text": "歩くより自転車のほうが速いです。"
 },
 {
  "id": "aa7a77ec2",
  "text": "コーヒーよりお茶が好きです。"
 },
 {
  "id": "a36a865b0",
  "text": "この道はあの道より広いです。"
 },
 {
  "id": "a438de59e",
  "text": "一人で行くより友達と行くほうが楽しいです。"
 },
 {
  "id": "ae44d0d3d",
  "text": "駅より病院のほうが近いです。"
 },
 {
  "id": "af6cec95f",
  "text": "明日、行く？"
 },
 {
  "id": "ad8f9a678",
  "text": "明日、行きますか。"
 },
 {
  "id": "a1b2bec19",
  "text": "明日、いらっしゃいますか。"
 },
 {
  "id": "a03f4b7e4",
  "text": "これ、私の傘だよ。"
 },
 {
  "id": "ada10bf2e",
  "text": "これは私の傘です。"
 },
 {
  "id": "a4b002095",
  "text": "田中と申します。"
 },
 {
  "id": "a69e2c8c0",
  "text": "お昼ご飯を召し上がりましたか。"
 },
 {
  "id": "a246c5355",
  "text": "私が参ります。"
 },
 {
  "id": "af37a5180",
  "text": "こちらにお名前をお書きください。"
 },
 {
  "id": "a9d41375d",
  "text": "よろしくお願いいたします。"
 }
]